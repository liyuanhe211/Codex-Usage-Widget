# Standard .gitignore (generated by Initialize_Project_Gitignore.py)

# Claude's exploratory scripts and temporary data (including archived user-provided screenshots)
_Claude_tmp/

# Sensitive / private files, second line of defense (case-insensitive, any position)
*[Ss][Ee][Cc][Rr][Ee][Tt]*
*[Pp][Rr][Ii][Vv][Aa][Tt][Ee]*

# Broad exclusions: temporary / obsolete / to-do (any case, any position; force-add a wrongly matched file with git add -f)
*[Tt][Ee][Mm][Pp]*
# Names containing "Template" are not temporary files: re-include them (must stay after the Temp pattern; cannot rescue a path whose parent directory is itself excluded)
!*[Tt][Ee][Mm][Pp][Ll][Aa][Tt][Ee]*
*[Oo][Bb][Ss][Oo][Ll][Ee][Tt][Ee]*
*[Tt][Oo][Dd][Oo]*

# Test files: not reviewed as strictly as production code and their fixtures may leak private data, so excluded by default (force-add a wrongly matched file with git add -f)
*[Tt][Ee][Ss][Tt]*

# Local Claude collaboration instructions and project settings
CLAUDE.md
.claude/

# Codex counterparts of the Claude entries above (the repo-level .agents/ plugin-marketplace directory is shared content and stays tracked)
AGENTS.md
AGENTS.override.md
.codex/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
build/
dist/

# Lint and test caches
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Node
node_modules/

# Environment variable files (keep API keys and the like out of the repository; .env.example is a key-free sample and is kept)
.env
.env.*
!.env.example

# Logs
*.log
logs/

# Office lock files and backup / temporary suffixes
~$*
*.bak
*.tmp
*.swp
*~

# Editors
.idea/
.vscode/
.history/

# System files
Thumbs.db
desktop.ini
.DS_Store
$RECYCLE.BIN/
ehthumbs.db
